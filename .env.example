# Frontend (Vite)
# Local dev (with Vite proxy): /api
# Production example: https://api.example.com/api
VITE_API_BASE_URL=

# Backend origin used by Vite dev proxy
# Example: http://localhost:4000
VITE_BACKEND_URL=

# Optional override for WebSocket base URL (without /ws/live-state)
# Example: ws://localhost:4000
VITE_WS_BASE_URL=
