# Frontend (Vite)
# Exposed to client via vite.config.js envPrefix.
# Production value requested: https://fifaleague.duckdns.org
NEXT_PUBLIC_API_URL=

# Optional explicit WS endpoint, including /ws/live-state
# Production value requested: wss://fifaleague.duckdns.org/ws/live-state
NEXT_PUBLIC_WS_URL=

# Optional Vite-specific fallback:
# VITE_API_BASE_URL=https://fifaleague.duckdns.org

# Backend origin used by Vite dev proxy
# Example: http://localhost:4000
VITE_BACKEND_URL=

# Optional override for WebSocket base URL (without /ws/live-state)
# Example: ws://localhost:4000
VITE_WS_BASE_URL=
