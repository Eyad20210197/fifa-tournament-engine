# Backend
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
# Neon example:
# postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=

# JWT settings
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Optional primary frontend URL (useful for single-origin deployments)
# Example: https://app.example.com
FRONTEND_URL=

# Comma-separated frontend origins allowed by CORS (no wildcards)
# Local example: http://localhost:5173
# Production example: https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=
