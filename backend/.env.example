# Backend
NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000

# PostgreSQL connection string
# Neon example:
# postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=

# JWT settings
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Comma-separated frontend origins allowed by CORS (no wildcards)
# Local example: http://localhost:5173
# Production example: https://fifa-ramadan-tournament-2026.vercel.app
ALLOWED_ORIGINS=

# VPS media directory for uploaded opening videos
MEDIA_VIDEOS_DIR=/var/www/tournament/media/videos
