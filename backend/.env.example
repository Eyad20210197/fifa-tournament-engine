# Backend
NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000

# PostgreSQL connection string
# Neon example:
# postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=

# JWT settings
JWT_SECRET=
JWT_EXPIRES_IN=12h

# CORS
# true allows all origins (use false in production and configure proxy/domain controls)
CORS_ALLOW_ALL_ORIGINS=true

# Ably (server-side)
ABLY_API_KEY=
ABLY_TOKEN_TTL_MS=3600000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_VIDEO=opening
CLOUDINARY_FOLDER_SPONSOR=sponsors
CLOUDINARY_FOLDER_BRANDING=branding

# Legacy local media directory (kept for compatibility)
MEDIA_VIDEOS_DIR=/var/www/tournament/media/videos
